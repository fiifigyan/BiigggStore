# apps/XStore/.env.example

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:9000
EXPO_PUBLIC_API_VERSION=v1

# Auth Endpoints
EXPO_PUBLIC_AUTH_LOGIN=/auth/login
EXPO_PUBLIC_AUTH_REGISTER=/auth/register
EXPO_PUBLIC_AUTH_ME=/auth/me
EXPO_PUBLIC_AUTH_LOGOUT=/auth/logout

# Product Endpoints
EXPO_PUBLIC_PRODUCTS=/products
EXPO_PUBLIC_PRODUCTS_FEATURED=/products/featured
EXPO_PUBLIC_PRODUCTS_SEARCH=/products/search
EXPO_PUBLIC_PRODUCTS_CATEGORIES=/products/categories

# Cart Endpoints
EXPO_PUBLIC_CART=/cart
EXPO_PUBLIC_CART_ITEMS=/cart/items
EXPO_PUBLIC_CART_CLEAR=/cart/clear

# Order Endpoints
EXPO_PUBLIC_ORDERS=/orders
EXPO_PUBLIC_ORDERS_STATUS=/orders/:id/status
EXPO_PUBLIC_ORDERS_CANCEL=/orders/:id/cancel

# User Endpoints
EXPO_PUBLIC_USER_PROFILE=/users/profile
EXPO_PUBLIC_USER_ADDRESSES=/users/addresses

# Payment Endpoints
EXPO_PUBLIC_PAYMENT_INITIATE=/payments/initiate
EXPO_PUBLIC_PAYMENT_VERIFY=/payments/verify

# Payment Configuration
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here
EXPO_PUBLIC_CURRENCY=GHS

# App Configuration
EXPO_PUBLIC_APP_NAME=XStore
EXPO_PUBLIC_APP_VERSION=1.0.0