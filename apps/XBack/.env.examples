# From email address used in outbound messages
# This must be a verified sending address or domain in Resend.
FROM_EMAIL=no-reply@yourverifieddomain.com

# Frontend base URL used to build reset links (no trailing slash)
FRONTEND_URL=http://localhost:19006

# Node environment
NODE_ENV=development
# Server
PORT=9000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biigggstore

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin API key
ADMIN_API_KEY=dev-admin-secret

# Cloudinary (required for cloud uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Resend API key. If set, Resend will be used to send email.
# Set this for the preferred email provider in production.
RESEND_API_KEY=your_resend_api_key